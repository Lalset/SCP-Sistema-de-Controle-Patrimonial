# Copie este arquivo para ".env" na raiz do projeto e preencha com os valores que precisar.
# NUNCA versione o arquivo ".env" de verdade, porque é os seus dados.

# Gere uma chave forte, por exemplo com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-forte

# Use "True" apenas em desenvolvimento local. Em produção deixe "False".
DEBUG=True

DB_NAME=projeto_tombamento
DB_USER=postgres
DB_PASSWORD=troque-por-uma-senha-forte
