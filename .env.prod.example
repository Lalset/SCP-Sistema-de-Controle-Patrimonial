# Copie pra ".env" na EC2 (mesmo nome do .env de desenvolvimento, só que
# com esses valores). Não versiona esse arquivo com dados reais.

SECRET_KEY=gere-uma-chave-nova-so-pra-producao
DEBUG=False

DB_NAME=projeto_tombamento
DB_USER=postgres
DB_PASSWORD=troque-por-uma-senha-forte-e-diferente-da-de-dev

# Preenche depois de tu rodar o gerar-certificado.sh e saber o IP público da EC2
ALLOWED_HOSTS=SEU_IP_PUBLICO
CORS_ALLOWED_ORIGINS=https://SEU_IP_PUBLICO
CSRF_TRUSTED_ORIGINS=https://SEU_IP_PUBLICO